# =============================================================================
# MLOps Cluster Configuration
# =============================================================================
# Copy this file to config.env and edit with your actual values:
#   cp config.env.example config.env
# =============================================================================

# --- SSH user (same on all nodes) ---
CLUSTER_USER=artur

# --- Node hostnames or IPs ---
PAWN_HOST=pawn-cluster
KNIGHT_HOST=knight-cluster
ROOK_HOST=rook-cluster
QUEEN_HOST=queen-cluster

# --- Service ports ---
PAWN_API_PORT=8081
KNIGHT_API_PORT=8082
ROOK_API_PORT=8080
QUEEN_API_PORT=8083
MLFLOW_PORT=5000

# --- Paths on each node (created automatically by deploy scripts) ---
PAWN_DATA_DIR=/home/artur/DATA
KNIGHT_TRAINING_DIR=/home/artur/TRAINING
ROOK_SERVING_DIR=/home/artur/SERVING
QUEEN_ORCHESTRATION_DIR=/home/artur/ORCHESTRATION

# --- MLflow tracking URI (used by knight-cluster) ---
MLFLOW_TRACKING_URI=http://queen-cluster:5000

# --- Pipeline schedule (cron expression: minute hour day month weekday) ---
# Default: every 6 hours
PIPELINE_SCHEDULE_CRON=0 */6 * * *

# --- Demo dataset ---
# The system ships with the Iris dataset for demonstration.
# Set to "true" to auto-generate sample data on first deploy.
GENERATE_DEMO_DATA=true
